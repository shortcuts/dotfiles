[user]
    email = vannicattec@gmail.com
    name = shortcuts

[core]
    pager = delta
    excludesFile = ~/.config/.gitignore.local
    untrackedCache = true

[rerere]
    enabled = true

[column]
    ui = auto

[branch]
    sort = committerdate

[interactive]
    diffFilter = delta --color-only

[delta]
    light = false
    line-numbers = true
    side-by-side = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[url "git@github.com:"]
    insteadOf = https://github.com/

[color]
    diff = auto
    status = auto
    branch = auto
    ui = true

[commit]
    verbose = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[alias]
    # single pager pass, else delta's less alt-screen hides the shortstat line
    d = "!f() { { git --no-pager diff --shortstat \"$@\"; git --no-pager diff --color=always \"$@\"; } | delta; }; f"
    branch-name = rev-parse --abbrev-ref HEAD
    # --boundary draws main as the stack base; remote refs are hidden to keep one name per line
    stack = log --graph --boundary --simplify-by-decoration --decorate-refs-exclude=refs/remotes --date=relative --format='%C(auto)%h%d%C(reset) %s %C(dim)%an, %cd%C(reset)' main..HEAD
[protocol "file"]
    allow = always

[maintenance]
	repo = ~/.config
	repo = ~/Documents/no-neck-pain.nvim
	repo = ~/Documents/data-ingestion
	repo = ~/Documents/api-clients-automation
[credential]
	helper = store
