{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 7,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CBM_HOOK_DEADLINE_MS": "4000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(./gradlew *)"
    ],
    "deny": [
      "Bash(make deploy)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)"
    ],
    "ask": [
      "Bash(chmod *)",
      "Bash(chmod 777:*)",
      "Bash(chown *)",
      "Bash(docker *)",
      "Bash(eval:*)",
      "Bash(fdisk *)",
      "Bash(gcloud *)",
      "Bash(git clean -fd:*)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(kubectl *)",
      "Bash(mkfs *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(sudo:*)",
      "Bash(unlink *)",
      "Bash(wget *)",
      "Bash(yarn publish*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.ssh/**)",
      "Bash(cat *.key)",
      "Bash(cat *.pem)",
      "Bash(cat *credential*)",
      "Bash(cat *secret*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.azure/*)",
      "Bash(cat ~/.ssh/*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/k/.local/bin/codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "gopls-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "interfaces@interfaces": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "interfaces": {
      "source": {
        "source": "github",
        "repo": "jakubkrehel/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "STE",
  "effortLevel": "medium",
  "theme": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
