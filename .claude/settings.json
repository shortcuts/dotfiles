{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(./gradlew *)"
    ],
    "deny": [
      "Bash(make deploy)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)"
    ],
    "ask": [
      "Bash(chmod *)",
      "Bash(chmod 777:*)",
      "Bash(chown *)",
      "Bash(docker *)",
      "Bash(eval:*)",
      "Bash(fdisk *)",
      "Bash(gcloud *)",
      "Bash(git clean -fd:*)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(kubectl *)",
      "Bash(mkfs *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(sudo:*)",
      "Bash(unlink *)",
      "Bash(wget *)",
      "Bash(yarn publish*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.ssh/**)",
      "Bash(cat *.key)",
      "Bash(cat *.pem)",
      "Bash(cat *credential*)",
      "Bash(cat *secret*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.azure/*)",
      "Bash(cat ~/.ssh/*)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
    {
        "matcher": "Bash",
        "hooks": [
            {
                "type": "command",
                "command": "rtk hook claude"
            }
        ]
    },
    {
        "hooks": [
            {
                "type": "command",
                "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh working"
            }
        ]
    },
    {
        "matcher": "Grep|Glob",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-code-discovery-gate'",
                "timeout": 5
            }
        ]
    }
],
    "SessionStart": [
    {
        "hooks": [
            {
                "type": "command",
                "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh start"
            }
        ]
    },
    {
        "matcher": "startup",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-session-reminder'",
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "resume",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-session-reminder'",
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "clear",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-session-reminder'",
                "timeout": 5
            }
        ]
    },
    {
        "matcher": "compact",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-session-reminder'",
                "timeout": 5
            }
        ]
    }
],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh notification"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh end"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh working"
          }
        ]
      }
    ],
    "PostToolUse": [
    {
        "matcher": "Read",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-code-discovery-gate'",
                "timeout": 5
            }
        ]
    }
],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/tmux-claude-code-status.sh stuck"
          }
        ]
      }
    ],
    "SubagentStart": [
    {
        "matcher": "*",
        "hooks": [
            {
                "type": "command",
                "command": "'/Users/clement.vannicatte/.config/.claude/hooks/cbm-subagent-reminder'",
                "timeout": 5
            }
        ]
    }
]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "gopls-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "theme": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
