#!/usr/bin/env bash
# herdr equivalent of tmux-session-finder: fzf-pick a dir, focus or create
# a herdr workspace for it. Workspace label = sanitized dir basename.

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
      {
        find ~/Documents -mindepth 1 -maxdepth 1 -type d
        printf '%s\n' \
          "$HOME/.config" \
          "$HOME/Downloads" \
          "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents"
      } | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

existing_id=$(herdr workspace list | jq -r --arg label "$selected_name" \
    '.result.workspaces[] | select(.label == $label) | .workspace_id' | head -n1)

if [[ -n $existing_id ]]; then
    herdr workspace focus "$existing_id"
else
    herdr workspace create --cwd "$selected" --label "$selected_name" --focus
fi
