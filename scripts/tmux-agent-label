#!/bin/sh
# Status line $1 for a $2-wide client focused on session $3: session names ($1=repo), or branches and window pips ($1=branch).
# The focused session also shows tmux-git-status after its branch: commits ahead/behind and lines changed.
# Both lines pad to the same width per session, so the branch sits under its name.
# One job draws the whole line: a #() per session keys on its active pane, so a new pane blanked its entry until the first run.
# tmux reruns a job as soon as its expanded command changes; further arguments only trigger that and are not read.
line=$1 width=${2:-80} focused=$3

{
    tmux list-panes -a -F 'P|#{session_name}|#{window_index}|#{window_active}|#{@pane_agent}|#{@pane_status}'
    # only the focused session reads git, and a session with nothing cached; the others keep @branch from when last focused
    # a window switch reruns this job too, so git runs at most once per status-interval
    now=$(date +%s)
    tmux list-panes -a -f '#{&&:#{window_active},#{pane_active}}' -F '#{session_name}|#{session_id}|#{pane_current_path}|#{@branch}|#{@git_at}|#{@git_detail}' |
        while IFS='|' read -r name id path branch at detail; do
            if [ "$name" = "$focused" ] && [ $((now - ${at:-0})) -ge 5 ] || [ -z "$branch$at" ]; then
                # claim the refresh first: the job for the other status line starts at the same time
                tmux set -q -t "=$name:" @git_at "$now"
                branch=$(git -C "$path" branch --show-current 2>/dev/null) && [ -z "$branch" ] && branch=$(git -C "$path" rev-parse --short HEAD)
                detail=
                [ "$name" = "$focused" ] && status=$("${0%/*}/tmux-git-status" "$path") && detail=${status#"#[fg=#768390]$branch"}
                tmux set -q -t "=$name:" @branch "$branch" \; set -q -t "=$name:" @git_detail "$detail"
            fi
            [ "$name" = "$focused" ] || detail=
            echo "S|$name|$id|$branch|$detail"
        done
} | awk -F'|' -v line="$line" -v w="$width" -v focused="$focused" '
    # one pip per window, filled for the active one, colored by its most urgent agent:
    # red waits or failed, orange works, green idle, grey no agent
    $1 == "P" {
        k = $2 SUBSEP $3
        if (!(k in rank)) { win[$2, ++nwin[$2]] = $3; active[k] = $4; rank[k] = 0 }
        if ($5 != "") { r = ($6 == "waiting" || $6 == "error") ? 3 : $6 != "idle" ? 2 : 1; if (r > rank[k]) rank[k] = r }
        next
    }
    { n++; name[n] = $2; id[n] = $3; branch[n] = $4; detail[n] = $5 }
    # lengths count bytes in macOS awk, so the multibyte pips and "…" add their widths by hand
    function cut(s, m) { if (length(s) > m) { cutw = m; return substr(s, 1, m - 1) "…" } cutw = length(s); return s }
    END {
        split("#768390 #57ab5a #f69d50 #e5534b", color, " ")
        for (i = 1; i <= n; i++) {
            s = name[i]; pips[i] = ""
            for (j = 1; j <= nwin[s]; j++) { k = s SUBSEP win[s, j]; pips[i] = pips[i] "#[fg=" color[rank[k] + 1] "]" (active[k] == 1 ? "■" : "□") }
            d = detail[i]; gsub(/#\[[^]]*\]/, "", d); gsub(/↑|↓/, "x", d)
            plen[i] = (nwin[s] ? nwin[s] + 1 : 0) + length(d)
            need[i] = length(s) > length(branch[i]) + plen[i] ? length(s) : length(branch[i]) + plen[i]
            sorted[i] = need[i]
        }
        for (i = 2; i <= n; i++) for (j = i; j > 1 && sorted[j - 1] > sorted[j]; j--) { t = sorted[j]; sorted[j] = sorted[j - 1]; sorted[j - 1] = t }
        # max-min fair share: sessions that need less than an even share keep their need, the rest split what is left
        # each entry takes 5 columns besides its text: 2 before, 1 pad, 1 separator, 1 after
        budget = w - 5 * n; max = sorted[n]
        for (i = 1; i <= n; i++) {
            share = int(budget / (n - i + 1))
            if (sorted[i] > share) { max = share; break }
            budget -= sorted[i]
        }
        if (max < 4) max = 4
        for (i = 1; i <= n; i++) {
            r = cut(name[i], max); rw = cutw
            bmax = max - plen[i]; if (bmax < 1) bmax = 1
            b = cut(branch[i], bmax); bw = cutw + plen[i]
            ew = rw > bw ? rw : bw
            text = line == "repo" ? "#[fg=#adbac7]" r : "#[fg=#768390]" b detail[i] (nwin[name[i]] ? " " pips[i] : "")
            tw = line == "repo" ? rw : bw
            printf "%s  #[range=user|%s]%s%*s#[norange] #[bg=default] ", (name[i] == focused ? "#[bg=#2d333b]" : ""), id[i], text, ew - tw + 1, ""
        }
    }'
