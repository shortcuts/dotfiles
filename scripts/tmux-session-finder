#!/usr/bin/env bash

# courtesy of @ThePrimeagen

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
      {
        find ~/Documents -mindepth 1 -maxdepth 1 -type d
        printf '%s\n' \
          "$HOME/.config" \
          "$HOME/Downloads" \
          "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents"
      } | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
selected_path=$(cd "$selected" && pwd -P)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected_path"
    exit 0
fi

# sessions get renamed on the fly, so match on cwd instead of name
existing=$(tmux list-sessions -f "#{==:#{session_path},$selected_path}" \
    -F '#{session_name}' 2>/dev/null | head -1)

if [[ -z $existing ]]; then
    existing=$selected_name
    tmux new-session -ds "$existing" -c "$selected_path"
fi

tmux switch-client -t "=$existing"
