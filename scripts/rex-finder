#!/usr/bin/env bash

# Runs as the only program of a floating layer; exiting closes the layer.
# One session per directory, created once, then reused.
# Esc in fzf exits without touching any session.

dirs=$(
  for d in ~/Documents/*/; do printf '%s\n' "${d%/}"; done
  printf '%s\n' \
    "$HOME/.config" \
    "$HOME/Downloads" \
    "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents"
)

selected=$(
  fzf --layout=reverse --height=100% --select-1 --exit-0 <<<"$dirs" \
      --border=rounded --border-label=' Sessions ' \
      --prompt='❯ ' --pointer='▶' --info=inline-right \
      --color='border:#30363d,label:#8b949e,fg:#c9d1d9,fg+:#f0f6fc,hl:#58a6ff,hl+:#79c0ff,prompt:#58a6ff,pointer:#58a6ff,info:#6e7681' \
      --delimiter=/ --with-nth=-1 --nth=-1
)

[[ -n $selected ]] || exit 0

name=${selected##*/}
name=${name//./_}

# match on label: `rex ls` reports no cwd, so a renamed session counts as new
id=$(rex ls --json | jq -r --arg n "$name" 'first(.sessions[] | select(.label == $n) | .session_id) // empty')

if [[ -z $id ]]; then
  id=$(rex new "$name" --cwd "$selected" --json | jq -r '.session_id')
  # Rex appends new sessions last; only the new one is out of order, so one move keeps the list sorted.
  pos=$(rex ls --json | jq -r --arg id "$id" '[.sessions | sort_by(.label | ascii_downcase) | .[].session_id] | index($id) + 1')
  rex session move "$id" --index "$pos"
fi

# client actions from the CLI need Remote Control on (Rex Settings > Rex Server)
rex do session.select session_id="$id"
