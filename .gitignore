# ignore everything but the lines below
# NOTE: for whitelisted directories we need both `!dir/` (un-ignore the dir
# so git descends into it) AND `!dir/**` (un-ignore its contents). Without
# the `**` rule, new files inside the dir get re-ignored by `*`.
*

# rpi
!rpi/
!rpi/**
!dnsmasq.conf

# docs
!*.md

# install
!install.sh
!Makefile

# window manager config
!aerospace/
!aerospace/**
!borders/
!borders/**

# term
!ghostty/
!ghostty/**
!btop/
!btop/**

# nvim config
!nvim/
!nvim/**
!stylua.toml

# fish config
!fish/
fish/*
!fish/config.fish
!fish/alias.fish
!fish/themes/
!fish/themes/**
!fish/conf.d/
fish/conf.d/*
!fish/conf.d/00-mise.fish
!fish/functions/
fish/functions/*
!fish/functions/g*
!fish/functions/rmdocker*
!fish/functions/rmgradle*
!fish/functions/cc.fish
!fish/functions/cleandisk*
!fish/functions/td*
!fish/functions/vpn*
!fish/functions/obsd*
!fish/functions/prettyjson*
!fish/functions/rfx.fish
fish/fish_variables*

# pkg manager
!mise/
!mise/**
# Written by install.sh on the full Mac only: it selects config.mac.toml.
mise/miserc.toml

# starship config
!starship.toml

# gh-dash (PR review TUI)
!gh-dash/
!gh-dash/**

# git
!git/
!git/ignore

# github workflows
!.git*
!.github/
!.github/**


# rex
!rex/
!rex/**

!scripts/
!scripts/**
scripts/obsidian-restructure.sh
scripts/.seen_shinies
scripts/**/.env

# keyboard
!keyboard/
!keyboard/**

# 3D printing / STL
!STL/
!STL/**
STL/**/.omc/
STL/.DS_Store

# ai takeover
!.claude/
!.claude/CLAUDE.md
!.claude/hooks/
!.claude/hooks/tmux-claude-code-status.sh
!.claude/output-styles/
!.claude/output-styles/**
!.claude/settings.json
!.claude/skills/
!.claude/skills/_shared/
!.claude/skills/_shared/**
!.claude/skills/documentation/
!.claude/skills/documentation/**
!.claude/skills/explain/
!.claude/skills/explain/**
!.claude/skills/no-ai-slop/
!.claude/skills/no-ai-slop/**
!.claude/skills/release-candidate/
!.claude/skills/release-candidate/**
!.claude/skills/release-notes/
!.claude/skills/release-notes/**
!.claude/skills/self-review/
!.claude/skills/self-review/**
!.claude/skills/test-audit/
!.claude/skills/test-audit/**
!.claude/skills/maintain-design/
!.claude/skills/maintain-design/**

# ccstatusline
!ccstatusline/
!ccstatusline/settings.json


# Un-ignored skill folders would track Python bytecode.
__pycache__/

# obsidian
!obsidian/
!obsidian/**
!quickadd-menubar/
!quickadd-menubar/**
